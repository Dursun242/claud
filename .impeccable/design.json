      "name": "Bouton secondaire",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Annuler, actions secondaires.",
      "html": "<button class=\"ds-btn-secondary\">Annuler</button>",
      "css": ".ds-btn-secondary{font-family: var(--font-dm-sans), 'DM Sans', sans-serif;padding:10px 18px;min-height:40px;background:#F1F5F9;color:#475569;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;transition:background 120ms cubic-bezier(.4,0,.2,1)}.ds-btn-secondary:hover{background:#E2E8F0}.ds-btn-secondary:focus-visible{outline:2px solid #3B82F6;outline-offset:2px}.ds-btn-secondary:active{transform:scale(.98)}"
    },
    {
