    {
      "name": "Bouton principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Action principale d'une zone, une seule fois.",
      "html": "<button class=\"ds-btn-primary\">Enregistrer</button>",
      "css": ".ds-btn-primary{font-family: var(--font-dm-sans), 'DM Sans', sans-serif;padding:10px 18px;min-height:40px;background:#1E3A5F;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;transition:transform 120ms cubic-bezier(.4,0,.2,1),box-shadow 180ms cubic-bezier(.4,0,.2,1)}.ds-btn-primary:hover{box-shadow:0 4px 12px rgba(15,23,42,0.10)}.ds-btn-primary:focus-visible{outline:2px solid #3B82F6;outline-offset:2px}.ds-btn-primary:active{transform:scale(.98)}"
    },
